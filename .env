# ========== 防护与修复配置 ==========
PROTECTION_MODE=strict              # strict, moderate, observe
HEALTH_CHECK_INTERVAL=30            # 秒
MAX_RETRY_BEFORE_REPAIR=3
AUTO_REPAIR_ENABLED=true
AUTO_ROLLBACK_ENABLED=true
SNAPSHOT_RETENTION_DAYS=7

# ========== 医疗监控阈值 ==========
CPU_ALERT_THRESHOLD=85              # %
RAM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90
GPU_TEMP_ALERT=85                   # °C
API_LATENCY_ALERT_MS=3000

# ========== 回溯系统 ==========
BACKUP_DIR=/var/backups/ai_env
STATE_SNAPSHOT_INTERVAL=3600        # 秒（每小时）
ENABLE_VERSION_CONTROL=true

# ========== 防御规则 ==========
BLOCK_IP_ON_FAILURE=5               # 失败5次封IP
RATE_LIMIT_REQUESTS=100             # 每秒
ENABLE_FIREWALL=true
DETECT_ANOMALY=true
